# The sikku kolam from a 'Make Rangoli' photo (11x1 straight dots), rebuilt from its gaps: every
# crossing gap read off the photo's pixels, plus its 8 crescent horns (refs/photo_remake.png).
# Crossing lines meet at 29 dots; the label reads them off the gaps (spec §8.5).
grid(11, 11)
c([0,5],[2,5])
c([2,3],[8,3])
c([2,4],[2,6])
c([2,7],[8,7])
c([4,1],[6,1])
c([4,2],[4,3])
c([4,4],[1,4],[1,6],[4,6])
c([4,5],[6,5])
c([4,7],[4,8])
c([4,9],[6,9])
c([5,0],[5,2])
c([5,4],[5,6])
c([5,8],[5,10])
c([6,2],[6,3])
c([6,4],[9,4],[9,6],[6,6])
c([6,7],[6,8])
c([8,4],[8,6])
c([8,5],[10,5])
c([3,2],[3,8],[7,8],[7,2],[3,2])
hl([1,4],W)
hl([3,8],N)
hl([7,2],S)
hl([9,6],E)
hr([1,6],E)
hr([3,2],N)
hr([7,8],S)
hr([9,4],W)
