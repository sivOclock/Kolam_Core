# Three brushes on a 5x5 dot grid
grid(5, 5)
c([0,0],[0,4])          # crossing-loop brush along the top row
p([2,0],[2,4])          # parallel-loop brush along the middle row
c([4,0],[4,4])          # crossing-loop brush along the bottom row
h([1,2],[1,1])          # plain horn: [1,2] -> [1,1]
hl([3,1],[3,2])         # left horn
hr([3,3],[3,4])         # right horn
